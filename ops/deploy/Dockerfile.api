# Submit API, results API, and the built dashboard, in one process.
# The frontend is compiled in a builder stage so the runtime image carries no
# node toolchain.
FROM node:22-slim AS frontend

WORKDIR /build
RUN corepack enable
COPY ops/frontend/package.json ops/frontend/pnpm-lock.yaml ops/frontend/pnpm-workspace.yaml ./
ENV CI=true
RUN pnpm install --frozen-lockfile
COPY ops/frontend/ ./
RUN pnpm build --outDir /build/static --emptyOutDir

FROM python:3.12-slim

# git for the submit-time agent.yaml check: the same shallow fetch grading does,
# run while the team is still at the keyboard.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
      fastapi==0.121.2 \
      "uvicorn[standard]==0.38.0" \
      boto3==1.40.47 \
      requests==2.32.5 \
      pyyaml==6.0.3

WORKDIR /app
# Only the producer and the shared contract: no Harbor, no tasks, no worker.
COPY ops/platform/common/ /app/common/
COPY ops/platform/api/ /app/api/
COPY --from=frontend /build/static /app/static

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
