# Host node_modules are macOS binaries and would overwrite the image's own,
# which is what made pnpm try to wipe the modules dir mid-build.
**/node_modules
**/.venv
jobs/
.jj/
.git/
# tasks-scored/ is its own clone, and its history is 5MB of build context
# that no image needs.
**/.git/
ops/terraform/.terraform/
ops/platform/static/
.env
